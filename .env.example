# dev = live reload (`next dev`), без --build на кожну зміну коду
# production = готовий образ з GHCR (`docker compose pull`), без --build на VPS
APP_ENV=dev

# Local Next.js (`npm run dev`) + `docker compose up db -d`
DATABASE_URL=postgresql://aicl:aicl@localhost:3402/aicl?schema=public

# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini 3.1 Flash-Lite: 500 req/day on free tier (same as 3.5 Lite, unused quota).
GEMINI_MODEL=gemini-3.1-flash-lite


# JWT для входу. Згенеруй довгий випадковий рядок (32+ символи).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# HTTP на VPS (без HTTPS) — false, інакше браузер не збереже сесію.
# Коли з’явиться HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false
